{
    "name": "Ruby Local Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/ruby:1-3.2-bookworm",
    "forwardPorts": [4000],
    "postCreateCommand": "bundle install",
    "postAttachCommand": "git config core.fileMode && git config core.autocrlf input",
    "customizations": {
        "vscode": {
            "extensions": [
                "sissel.shopify-liquid",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    }
}
